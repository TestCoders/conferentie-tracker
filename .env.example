# Kopieer naar .env.local en vul in. NOOIT .env.local committen.
# Alle variabelen zijn server-only: gebruik NOOIT het prefix NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>

# Microsoft Entra ID (Auth.js). Gebruik secret-WAARDE, niet de secret-ID.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-uuid>/v2.0
AUTH_SECRET=
# Alleen buiten Vercel achter een vertrouwde reverse proxy expliciet instellen.
# AUTH_TRUST_HOST=true
