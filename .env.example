# Kopieer naar .env.local en vul in. NOOIT .env.local committen.
# Alle variabelen zijn server-only: gebruik NOOIT het prefix NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
ADMIN_TOKEN=<zelf-gegenereerd-sterk-token>   # bv. `openssl rand -hex 32`

# AI-verrijking (OpenRouter). Server-only. Gratis modellen: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=<server-only-secret>
# Optioneel; standaard de router voor gratis modellen.
OPENROUTER_MODEL=openrouter/free
